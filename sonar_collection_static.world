<?xml version="1.0"?>
<!-- Dedicated static-sonar collection scene: seabed, one box, one pipe; no ROV. -->
<sdf version="1.9">
  <world name="dave_sonar_collection_static">
    <physics name="collection_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="multibeam_sonar_system" name="custom::MultibeamSonarSystem"/>

    <spherical_coordinates>
      <latitude_deg>35.074823</latitude_deg>
      <longitude_deg>129.084798</longitude_deg>
    </spherical_coordinates>
    <scene>
      <ambient>0.01 0.01 0.01 1</ambient>
      <background>0.02 0.05 0.09 1</background>
      <shadows>0</shadows>
    </scene>
    <light type="directional" name="collection_sun">
      <pose>0 0 30 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.2 -0.1 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Coast Water</uri>
      <name>collection_water</name>
    </include>
    <include>
      <uri>https://fuel.gazebosim.org/1.0/hmoyen/models/Sand Heightmap</uri>
      <name>collection_seabed</name>
      <pose>0 0 -16 0 0 0</pose>
      <static>true</static>
    </include>

    <!-- Box / crate target. The collection launcher points the fixed sonar at it. -->
    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Test box</uri>
      <name>collection_box</name>
      <pose>35 12 -15.55 0 0 0.15</pose>
      <static>true</static>
    </include>

    <!-- Pipe target: simple, static cylinder aligned along world X. -->
    <model name="collection_pipe">
      <static>true</static>
      <pose>48 21 -15.55 0 1.5707963 0</pose>
      <link name="pipe_link">
        <visual name="pipe_visual">
          <geometry><cylinder><radius>0.28</radius><length>8.0</length></cylinder></geometry>
          <material>
            <ambient>0.12 0.16 0.18 1</ambient>
            <diffuse>0.18 0.24 0.27 1</diffuse>
            <specular>0.25 0.25 0.25 1</specular>
          </material>
        </visual>
        <collision name="pipe_collision">
          <geometry><cylinder><radius>0.28</radius><length>8.0</length></cylinder></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>
